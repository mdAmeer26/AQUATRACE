ESA_PASSWORD=your_copernicus_password

# Mapbox
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Data Directories
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_DIR=./data/models
CACHE_DIR=./data/cache

# ML Model Settings
MODEL_VERSION=v1.0
BATCH_SIZE=32
CONFIDENCE_THRESHOLD=0.7

# Update Schedule (cron format)
DATA_FETCH_SCHEDULE=0 2 * * *  # Daily at 2 AM
PROCESSING_SCHEDULE=0 4 * * *  # Daily at 4 AM

# Alert Settings
ALERT_THRESHOLD_HIGH=0.8
ALERT_THRESHOLD_CRITICAL=0.95
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_TO=alerts@example.com

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aquatrace.log
